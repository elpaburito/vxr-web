VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
# PayMongo — publishable (test) key. The matching secret key and
# webhook signing secret live only on the Supabase Edge Functions
# (set via `supabase secrets set …`); never commit a secret key into
# the frontend or .env.example. See supabase/functions/PAYMONGO_SETUP.md.
VITE_PAYMONGO_PUBLIC_KEY=pk_test_your-paymongo-public-key
# Enable mock payment methods (school-demo mode). When true, users can
# register a 'mock' payment method that completes payments instantly
# without contacting PayMongo. NEVER set to true in production.
# The server-side flag MOCK_PAYMENTS_ENABLED must also be true on the
# Supabase Edge Functions for mock methods to work.
VITE_MOCK_PAYMENTS_ENABLED=false
